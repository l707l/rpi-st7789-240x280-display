+  systemTimerLow = (volatile uint32_t*)((uintptr_t)bcm2835 + BCM2835_TIMER_BASE + 0x04);
+  systemTimerHigh = (volatile uint32_t*)((uintptr_t)bcm2835 + BCM2835_TIMER_BASE + 0x08); // Generates an unaligned 64-bit pointer, but seems to be fine.
