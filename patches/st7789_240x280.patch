diff --git a/tick.h b/tick.h
index 2036168..94183db 100644
--- a/tick.h
+++ b/tick.h
@@ -5,8 +5,19 @@
 #include <unistd.h>
 
 // Initialized in spi.cpp along with the rest of the BCM2835 peripheral:
-extern volatile uint64_t *systemTimerRegister;
-#define tick() (*systemTimerRegister)
+extern volatile uint32_t *systemTimerLow;
+extern volatile uint32_t *systemTimerHigh;
+
+static inline uint64_t tick() {
+  uint32_t hi = *systemTimerHigh;
+  uint32_t lo = *systemTimerLow;
+  uint32_t hi2 = *systemTimerHigh;
+  if (hi != hi2) {
+    lo = *systemTimerLow;
+    hi = hi2;
+  }
+  return (((uint64_t)hi) << 32) | lo;
+}
 
 #endif
 
